{
  "//": "Configuração própria da versão web, para o Vite não herdar a do app (que depende do Expo).",
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "allowJs": true,
    "checkJs": false,
    "noEmit": true,
    "skipLibCheck": true
  },
  "include": ["src", "vite.config.js"]
}
